# Optional public Giscus override. Vite exposes PUBLIC_* through envPrefix.
# Copy to .env, set all four values, then restart dev or rebuild the static site.
# Discussion terms retain the original "posts/<slug>" mapping, without trailing
# slashes. Keep published slugs stable; each article remounts its own widget.
PUBLIC_GISCUS_REPO=
PUBLIC_GISCUS_REPO_ID=
PUBLIC_GISCUS_CATEGORY=
PUBLIC_GISCUS_CATEGORY_ID=

{
  "name": "flurry-blog",
  "type": "module",
  "version": "7.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/copy-katex.mjs",
    "build": "vite build && node scripts/copy-404.mjs && node scripts/generate-rss.mjs && node scripts/build-search-index.mjs && cp -r dist/pagefind public/",
    "preview": "vite preview",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "vue": "^3.5.42",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mdit/plugin-katex": "^1.0.1",
    "@shikijs/markdown-it": "^4.3.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/markdown-it": "^14.1.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.8.0",
    "gray-matter": "^4.0.3",
    "katex": "^0.18.1",
    "markdown-it": "^14.3.0",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shiki": "^4.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}

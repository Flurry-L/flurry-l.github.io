---
import { Search as SearchIcon } from '@lucide/vue';
import '../styles/components/search.css';
import { SITE } from '../site';

interface Props {
  variant?: 'input' | 'icon';
}

const { variant = 'input' } = Astro.props;
---

<div class="site-search" data-site-search data-variant={variant}>
  {variant === 'icon' ? (
    <button
      class="search-loader search-loader-icon"
      type="button"
      aria-haspopup="dialog"
      aria-label="搜索文章"
      title="搜索文章"
      data-search-loader
    >
      <SearchIcon size={20} strokeWidth={1.8} aria-hidden="true" />
    </button>
  ) : (
    <button
      class="search-loader"
      type="button"
      aria-haspopup="dialog"
      data-search-loader
    >
      <SearchIcon size={18} strokeWidth={1.8} aria-hidden="true" />
      <span data-search-loader-label>搜索文章</span>
    </button>
  )}
  <pagefind-config bundle-path="/pagefind/" lang={SITE.locale}></pagefind-config>
  <pagefind-modal-trigger
    hide-shortcut
    placeholder="搜索文章"
  ></pagefind-modal-trigger>
  <pagefind-modal reset-on-close></pagefind-modal>
</div>

<script>
  import { initSearch } from '../scripts/search';

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-site-search]').forEach((root) => {
      initSearch(root);
    });
  });
</script>

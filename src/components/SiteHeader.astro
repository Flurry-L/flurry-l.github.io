---
import { Menu, X } from '@lucide/vue';
import '../styles/components/site-header.css';
import { NAV_ITEMS, SITE } from '../site';

interface Props {
  activeSection?: 'articles';
}

const { activeSection } = Astro.props;
const pathname = Astro.url.pathname;
const isCurrent = (href: string) => pathname === href;
const isActive = (href: string) => href === '/'
  ? pathname === '/' || activeSection === 'articles'
  : pathname.startsWith(href);
---

<header id="top" class="site-header" tabindex="-1">
  <div class="site-header-inner">
    <a class="site-identity" href="/" aria-label={`${SITE.title} 首页`}>
      <img src={SITE.avatar} width="40" height="40" alt="Flurry 的头像" />
      <strong>{SITE.title}</strong>
    </a>

    <div class="site-header-end">
      <nav class="site-nav" aria-label="主导航">
        {NAV_ITEMS.map((item) => (
          <a
            href={item.href}
            class:list={{ 'is-active': isActive(item.href) }}
            aria-current={isCurrent(item.href) ? 'page' : isActive(item.href) ? 'location' : undefined}
          >
            {item.label}
          </a>
        ))}
      </nav>
      <button
        class="site-sidebar-toggle"
        type="button"
        aria-label="打开站点信息"
        aria-controls="site-sidebar"
        aria-expanded="false"
        data-sidebar-toggle
      >
        <Menu class="site-sidebar-toggle-open" size={20} strokeWidth={1.8} aria-hidden="true" />
        <X class="site-sidebar-toggle-close" size={20} strokeWidth={1.8} aria-hidden="true" />
      </button>
    </div>
  </div>
</header>

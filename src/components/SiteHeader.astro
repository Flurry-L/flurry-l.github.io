---
import { Mail, Rss } from '@lucide/vue';
import { siGithub } from 'simple-icons';
import ThemeToggle from './ThemeToggle.vue';
import { NAV_ITEMS, SITE } from '../site';

interface Props {
  activeSection?: 'articles';
}

const { activeSection } = Astro.props;
const pathname = Astro.url.pathname;
const isCurrent = (href: string) => pathname === href;
const isActive = (href: string) => href === '/'
  ? pathname === '/' || activeSection === 'articles'
  : pathname.startsWith(href);
---

<header id="top" class="site-header" tabindex="-1">
  <div class="site-header-inner">
    <a class="site-identity" href="/" aria-label={`${SITE.title} 首页`}>
      <img src={SITE.avatar} width="40" height="40" alt="Flurry 的头像" />
      <span>
        <strong>{SITE.shortTitle}</strong>
        <small>{SITE.description}</small>
      </span>
    </a>

    <nav class="site-nav" aria-label="主导航">
      {NAV_ITEMS.map((item) => (
        <a
          href={item.href}
          class:list={{ 'is-active': isActive(item.href) }}
          aria-current={isCurrent(item.href) ? 'page' : isActive(item.href) ? 'location' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="header-actions">
      <nav class="header-tools" aria-label="联系与订阅">
        <a class="header-tool" href={SITE.github} rel="me noreferrer" aria-label="GitHub" title="GitHub">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d={siGithub.path}></path>
          </svg>
        </a>
        <a class="header-tool" href={SITE.email} aria-label="Email" title="Email">
          <Mail size={18} strokeWidth={1.8} aria-hidden="true" />
        </a>
        <a class="header-tool" href="/rss.xml" aria-label="RSS" title="RSS">
          <Rss size={18} strokeWidth={1.8} aria-hidden="true" />
        </a>
      </nav>
      <ThemeToggle client:load />
    </div>
  </div>
</header>

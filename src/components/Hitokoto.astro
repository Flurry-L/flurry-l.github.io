---
import { RefreshCw } from '@lucide/vue';
import '../styles/components/hitokoto.css';
---

<button
  class="hitokoto"
  type="button"
  data-hitokoto
  data-state="idle"
  aria-label="换一句"
  aria-describedby="hitokoto-text hitokoto-from"
  aria-busy="false"
  title="换一句"
>
  <span id="hitokoto-text" class="hitokoto-text" data-hitokoto-text>行到水穷处，坐看云起时。</span>
  <span id="hitokoto-from" class="hitokoto-from" data-hitokoto-from>——《终南别业》· 王维</span>
  <RefreshCw class="hitokoto-refresh-icon" size={16} strokeWidth={1.8} aria-hidden="true" />
  <span class="sr-only" data-hitokoto-status aria-live="polite" aria-atomic="true"></span>
</button>

<script>
  import { initHitokoto } from '../scripts/hitokoto';

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLButtonElement>('[data-hitokoto]').forEach((root) => {
      initHitokoto(root);
    });
  });
</script>

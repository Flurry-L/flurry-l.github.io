---
import { Mail, Rss } from '@lucide/vue';
import { getPublishedPosts } from '../data/posts';
import { SITE } from '../site';
import '../styles/components/site-sidebar.css';
import { getTagCounts } from '../utils/posts';
import Hitokoto from './Hitokoto.astro';
import Search from './Search.astro';
import ThemeToggle from './ThemeToggle.astro';

const posts = await getPublishedPosts();
const tags = getTagCounts(posts);
---

<aside
  id="site-sidebar"
  class="site-sidebar"
  aria-label="站点信息与工具"
  aria-hidden="false"
  data-site-sidebar
  tabindex="-1"
>
  <div class="site-sidebar-card">
    <div class="site-sidebar-profile">
      <img
        class="site-sidebar-avatar"
        src={SITE.avatar}
        width="80"
        height="80"
        alt={`${SITE.author} 的头像`}
        decoding="async"
      />
      <div class="site-sidebar-identity">
        <p class="site-sidebar-author">{SITE.author}</p>
        <p class="site-sidebar-description">{SITE.description}</p>
      </div>
    </div>

    <div class="site-sidebar-controls">
      <nav class="site-sidebar-stats" aria-label="内容索引">
        <a href="/archives/" aria-label={`查看全部 ${posts.length} 篇文章`}>
          <span>文章</span>
          <strong>{posts.length}</strong>
        </a>
        <a href="/tags/" aria-label={`查看全部 ${tags.length} 个标签`}>
          <span>标签</span>
          <strong>{tags.length}</strong>
        </a>
      </nav>

      <div class="site-sidebar-search">
        <Search />
      </div>

      <div class="site-sidebar-tools" role="group" aria-label="站点工具">
        <a
          class="site-sidebar-tool"
          href={SITE.github}
          rel="me noreferrer"
          aria-label="GitHub"
          title="GitHub"
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3.28-.36 6.72-1.61 6.72-7.25A5.65 5.65 0 0 0 19.22 3.3 5.27 5.27 0 0 0 19.13.31S17.95-.05 15 1.8a13.38 13.38 0 0 0-7 0C5.05-.05 3.87.31 3.87.31A5.27 5.27 0 0 0 3.78 4a5.65 5.65 0 0 0-1.5 3.91c0 5.63 3.44 6.88 6.72 7.25A4.8 4.8 0 0 0 8 18.67V22"></path>
            <path d="M9 18c-4.51 2-5-2-7-2"></path>
          </svg>
        </a>
        <a
          class="site-sidebar-tool"
          href={SITE.email}
          aria-label="邮件"
          title="邮件"
        >
          <Mail size={20} strokeWidth={1.8} aria-hidden="true" />
        </a>
        <a
          class="site-sidebar-tool"
          href="/rss.xml"
          aria-label="RSS"
          title="RSS"
        >
          <Rss size={20} strokeWidth={1.8} aria-hidden="true" />
        </a>
        <ThemeToggle />
      </div>
    </div>
  </div>

  <Hitokoto />
</aside>

<div class="site-sidebar-scrim" data-sidebar-scrim aria-hidden="true"></div>

<script>
  import { initSiteSidebar } from '../scripts/site-sidebar';

  initSiteSidebar();
</script>

---
import Hitokoto from './Hitokoto.vue';
import ThemeToggle from './ThemeToggle.vue';
import { NAV_ITEMS, SITE } from '../site';

const pathname = Astro.url.pathname;
const isActive = (href: string) => href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<aside class="site-sidebar">
  <div class="sidebar-topline">
    <a class="site-identity" href="/" aria-label={`${SITE.title} 首页`}>
      <img src={SITE.avatar} width="48" height="48" alt="Flurry 的头像" />
      <span>
        <strong>{SITE.title}</strong>
        <small>{SITE.description}</small>
      </span>
    </a>
    <ThemeToggle client:load />
  </div>

  <nav class="site-nav" aria-label="主导航">
    {NAV_ITEMS.map((item) => (
      <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
        {item.label}
      </a>
    ))}
  </nav>

  <div class="sidebar-secondary">
    <Hitokoto client:visible />
    <div class="profile-links" aria-label="联系方式">
      <a href={SITE.github} rel="me noreferrer">GitHub</a>
      <a href={SITE.email}>Email</a>
      <a href="/rss.xml">RSS</a>
    </div>
  </div>
</aside>

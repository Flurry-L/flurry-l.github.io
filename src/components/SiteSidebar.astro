---
import { getPublishedPosts } from '../data/posts';
import { SITE } from '../site';
import '../styles/components/site-sidebar.css';
import { getTagCounts } from '../utils/posts';
import Hitokoto from './Hitokoto.astro';

const posts = await getPublishedPosts();
const tags = getTagCounts(posts);
---

<aside
  id="site-sidebar"
  class="site-sidebar"
  aria-label="站点信息与工具"
  aria-hidden="false"
  data-site-sidebar
  tabindex="-1"
>
  <div class="site-sidebar-profile">
    <img
      class="site-sidebar-avatar"
      src={SITE.avatar}
      width="80"
      height="80"
      alt={`${SITE.author} 的头像`}
      decoding="async"
    />
    <p class="site-sidebar-author">{SITE.author}</p>
    <p class="site-sidebar-description">{SITE.description}</p>
  </div>

  <nav class="site-sidebar-stats" aria-label="内容索引">
    <a href="/archives/" aria-label={`查看全部 ${posts.length} 篇文章`}>
      <span>文章</span>
      <strong>{posts.length}</strong>
    </a>
    <a href="/tags/" aria-label={`查看全部 ${tags.length} 个标签`}>
      <span>标签</span>
      <strong>{tags.length}</strong>
    </a>
  </nav>

  <div class="site-sidebar-social" role="group" aria-label="站外链接">
    <a href={SITE.github} rel="me noreferrer" aria-label="GitHub" title="GitHub">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
      </svg>
      <span>GitHub</span>
    </a>
    <a href={SITE.email} aria-label="邮件" title="邮件">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M20,8L12,13L4,8V6L12,11L20,6M20,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V6C22,4.89 21.1,4 20,4Z" />
      </svg>
      <span>邮件</span>
    </a>
    <a href="/rss.xml" aria-label="RSS" title="RSS">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M19.199 24C19.199 13.467 10.533 4.8 0 4.8V0c13.165 0 24 10.835 24 24h-4.801zM3.291 17.415c1.814 0 3.293 1.479 3.293 3.295 0 1.813-1.485 3.29-3.301 3.29C1.47 24 0 22.526 0 20.71s1.475-3.294 3.291-3.295zM15.909 24h-4.665c0-6.169-5.075-11.245-11.244-11.245V8.09c8.727 0 15.909 7.184 15.909 15.91z" />
      </svg>
      <span>RSS</span>
    </a>
  </div>

  <Hitokoto />
</aside>

<div class="site-sidebar-scrim" data-sidebar-scrim aria-hidden="true"></div>

<script>
  import { initSiteSidebar } from '../scripts/site-sidebar';

  let cleanup: (() => void) | undefined;
  document.addEventListener('astro:page-load', () => {
    cleanup = initSiteSidebar();
  });
  document.addEventListener('astro:before-swap', () => {
    cleanup?.();
    cleanup = undefined;
  });
</script>

---
const repo = import.meta.env.PUBLIC_GISCUS_REPO?.trim();
const repoId = import.meta.env.PUBLIC_GISCUS_REPO_ID?.trim();
const category = import.meta.env.PUBLIC_GISCUS_CATEGORY?.trim();
const categoryId = import.meta.env.PUBLIC_GISCUS_CATEGORY_ID?.trim();
const isConfigured = Boolean(repo && repoId && category && categoryId);
---

{isConfigured && (
  <section class="comments-section" aria-labelledby="comments-heading" data-comments>
    <h2 id="comments-heading">评论</h2>
    <div class="giscus"></div>

    <script is:inline define:vars={{ repo, repoId, category, categoryId }}>
      const section = document.currentScript?.closest('[data-comments]');
      const container = section?.querySelector('.giscus');

      if (container) {
        const getTheme = () =>
          document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';

        const giscusScript = document.createElement('script');
        giscusScript.src = 'https://giscus.app/client.js';
        giscusScript.async = true;
        giscusScript.crossOrigin = 'anonymous';
        giscusScript.dataset.repo = repo;
        giscusScript.dataset.repoId = repoId;
        giscusScript.dataset.category = category;
        giscusScript.dataset.categoryId = categoryId;
        giscusScript.dataset.mapping = 'pathname';
        giscusScript.dataset.strict = '1';
        giscusScript.dataset.reactionsEnabled = '1';
        giscusScript.dataset.emitMetadata = '0';
        giscusScript.dataset.inputPosition = 'top';
        giscusScript.dataset.theme = getTheme();
        giscusScript.dataset.lang = 'zh-CN';
        giscusScript.dataset.loading = 'lazy';

        const syncTheme = () => {
          const theme = getTheme();
          giscusScript.dataset.theme = theme;
          const iframe = container.querySelector('.giscus-frame');
          iframe?.contentWindow?.postMessage(
            { giscus: { setConfig: { theme } } },
            'https://giscus.app',
          );
        };

        const observer = new MutationObserver(() => {
          const iframe = container.querySelector('.giscus-frame');
          if (!iframe) return;
          iframe.addEventListener('load', syncTheme, { once: true });
          observer.disconnect();
        });

        observer.observe(container, { childList: true });
        window.addEventListener('theme-change', syncTheme);
        container.append(giscusScript);
      }
    </script>
  </section>
)}

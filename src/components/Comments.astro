---
import '../styles/components/comments.css';
import { GISCUS, SITE } from '../site';

const envConfig = {
  repo: import.meta.env.PUBLIC_GISCUS_REPO?.trim(),
  repoId: import.meta.env.PUBLIC_GISCUS_REPO_ID?.trim(),
  category: import.meta.env.PUBLIC_GISCUS_CATEGORY?.trim(),
  categoryId: import.meta.env.PUBLIC_GISCUS_CATEGORY_ID?.trim(),
};
const envValues = Object.values(envConfig);
const hasAnyOverride = envValues.some(Boolean);
const hasCompleteOverride = envValues.every(Boolean);

if (hasAnyOverride && !hasCompleteOverride) {
  console.warn('[giscus] Ignoring partial environment override; set all four PUBLIC_GISCUS_* values.');
}

const { repo, repoId, category, categoryId } = hasCompleteOverride ? envConfig : GISCUS;
const isConfigured = Boolean(repo && repoId && category && categoryId);
---

{isConfigured && (
  <section
    class="comments-section"
    aria-labelledby="comments-heading"
    data-floating-controls-clear
  >
    <h2 id="comments-heading">评论</h2>
    <div class="giscus">
      <script is:inline>
        // Set the initial theme before the giscus loader runs, so dark-mode
        // readers never see a light iframe flash.
        const loader = document.currentScript?.parentElement?.querySelector('script[src*="giscus"]');
        loader?.setAttribute(
          'data-theme',
          document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light',
        );
      </script>
      <script
        is:inline
        src="https://giscus.app/client.js"
        data-repo={repo}
        data-repo-id={repoId}
        data-category={category}
        data-category-id={categoryId}
        data-mapping="pathname"
        data-strict="0"
        data-reactions-enabled="1"
        data-emit-metadata="0"
        data-input-position="top"
        data-theme="light"
        data-lang={SITE.locale}
        data-loading="lazy"
        crossorigin="anonymous"
        async
      ></script>
    </div>

    <script>
      const syncGiscusTheme = () => {
        const frame = document.querySelector<HTMLIFrameElement>('.giscus-frame');
        frame?.contentWindow?.postMessage({
          giscus: {
            setConfig: {
              theme: document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light',
            },
          },
        }, 'https://giscus.app');
      };

      window.addEventListener('theme-change', syncGiscusTheme);
      window.addEventListener('message', (event) => {
        if (event.origin === 'https://giscus.app' && event.data?.giscus) syncGiscusTheme();
      });
    </script>
  </section>
)}

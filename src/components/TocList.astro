---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

interface TocGroup {
  heading: MarkdownHeading;
  children: MarkdownHeading[];
}

const groups: TocGroup[] = [];

for (const heading of Astro.props.headings) {
  if (heading.depth === 2 || groups.length === 0) {
    groups.push({ heading, children: [] });
  } else {
    groups.at(-1)?.children.push(heading);
  }
}
---

<ol class="toc-list">
  {groups.map((group) => (
    <li class="toc-list-item">
      <a
        class:list={['toc-link', `node-name--H${group.heading.depth}`]}
        href={`#${group.heading.slug}`}
      >
        {group.heading.text}
      </a>
      {group.children.length > 0 && (
        <ol class="toc-list">
          {group.children.map((heading) => (
            <li class="toc-list-item">
              <a
                class="toc-link node-name--H3"
                href={`#${heading.slug}`}
              >
                {heading.text}
              </a>
            </li>
          ))}
        </ol>
      )}
    </li>
  ))}
</ol>

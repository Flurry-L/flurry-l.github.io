---
import '../styles/components/post-card.css';
import '../styles/components/post-meta.css';
import type { Post } from '../utils/posts';
import { formatDate, getExcerpt, getReadingTime } from '../utils/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
---

<article class="content-card post-card">
  <h2><a class="post-card-link" href={`/${post.id}/`}>{post.data.title}</a></h2>
  <div class="post-meta post-card-facts">
    <time class="post-meta-item" datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
    <span class="post-meta-item">{getReadingTime(post)} 分钟</span>
  </div>
  <p>{getExcerpt(post)}</p>
  {post.data.tags.length > 0 && (
    <nav class="post-card-tags" aria-label={`《${post.data.title}》的标签`}>
      {post.data.tags.map((tag) => <a href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a>)}
    </nav>
  )}
</article>

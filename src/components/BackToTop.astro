---
import { ArrowUp } from '@lucide/vue';

interface Props {
  minPageViewports?: number;
  showAfterViewports?: number;
}

const {
  minPageViewports = 4,
  showAfterViewports = 2.5,
} = Astro.props;
---

<a
  class="floating-back-to-top"
  href="#top"
  data-back-to-top
  aria-label="回到顶部"
  title="回到顶部"
  data-min-page-viewports={minPageViewports}
  data-show-after-viewports={showAfterViewports}
  hidden
  tabindex="-1"
>
  <ArrowUp size={19} strokeWidth={1.8} aria-hidden="true" />
</a>

<script is:inline>
  (() => {
    const installKey = '__flurryBackToTopInstalled';
    if (window[installKey]) return;
    window[installKey] = true;

    function enhanceBackToTop() {
      const links = [...document.querySelectorAll('[data-back-to-top]')]
        .filter((link) => link instanceof HTMLAnchorElement);
      if (links.length === 0) return;

      const topTarget = document.getElementById('top');
      links.forEach((link) => {
        link.addEventListener('click', () => {
          requestAnimationFrame(() => {
            if (topTarget instanceof HTMLElement) topTarget.focus({ preventScroll: true });
          });
        });
      });

      const clearRegions = [...document.querySelectorAll('[data-floating-controls-clear]')]
        .filter((region) => region instanceof HTMLElement);
      if ('IntersectionObserver' in window && clearRegions.length > 0) {
        const visibleClearRegions = new Set();
        const clearObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) visibleClearRegions.add(entry.target);
            else visibleClearRegions.delete(entry.target);
          });
          document.body.classList.toggle(
            'floating-controls-clear',
            visibleClearRegions.size > 0,
          );
        }, { threshold: 0.01 });
        clearRegions.forEach((region) => clearObserver.observe(region));
      }

      const controller = links.find((link) => link.classList.contains('floating-back-to-top'));
      const minPageViewports = Number(controller?.dataset.minPageViewports) || 4;
      const showAfterViewports = Number(controller?.dataset.showAfterViewports) || 2.5;
      const hasDesktopToc = document.querySelector('[data-post-toc-desktop]') !== null;
      links.forEach((link) => {
        if (link.classList.contains('floating-back-to-top')) {
          link.dataset.desktopToc = String(hasDesktopToc);
        }
      });

      let frame = 0;

      function update() {
        frame = 0;
        const pageIsLong = document.documentElement.scrollHeight
          > window.innerHeight * minPageViewports;
        const shouldShow = pageIsLong
          && window.scrollY > window.innerHeight * showAfterViewports;

        links.forEach((link) => {
          link.hidden = !shouldShow;
          link.tabIndex = shouldShow ? 0 : -1;
        });
      }

      function schedule() {
        if (frame === 0) frame = requestAnimationFrame(update);
      }

      window.addEventListener('scroll', schedule, { passive: true });
      window.addEventListener('resize', schedule);
      new ResizeObserver(schedule).observe(document.body);
      update();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', enhanceBackToTop, { once: true });
    } else {
      enhanceBackToTop();
    }
  })();
</script>

---
import { Moon, Sun } from '@lucide/vue';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<button
  class:list={['header-tool theme-toggle', className]}
  type="button"
  aria-label="切换颜色主题"
  title="切换颜色主题"
  data-theme-toggle
>
  <Sun class="theme-icon theme-icon-sun" size={20} strokeWidth={1.8} aria-hidden="true" />
  <Moon class="theme-icon theme-icon-moon" size={20} strokeWidth={1.8} aria-hidden="true" />
</button>

<script>
  import { initThemeToggle } from '../scripts/theme';

  document.addEventListener('astro:page-load', () => initThemeToggle());
</script>

<style>
  .theme-toggle {
    position: relative;
  }

  .theme-icon-sun {
    display: none;
  }

  :global(:root[data-theme='dark']) .theme-icon-sun {
    display: block;
  }

  :global(:root[data-theme='dark']) .theme-icon-moon {
    display: none;
  }
</style>

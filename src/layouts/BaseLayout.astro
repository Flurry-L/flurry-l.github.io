---
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import CodeBlockEnhancer from '../components/CodeBlockEnhancer.astro';
import BackToTop from '../components/BackToTop.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { SITE } from '../site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
  activeSection?: 'articles';
  layout?: 'default' | 'home' | 'listing';
}

const {
  title,
  description = SITE.description,
  image = '/og.png',
  article = false,
  activeSection,
  layout = 'default',
} = Astro.props;
const pageTitle = title ? `${title} | ${SITE.title}` : SITE.title;
const canonical = new URL(Astro.url.pathname, SITE.url);
const imageUrl = new URL(image, SITE.url);
const resolvedLayout = article ? 'article' : layout;
const showBackToTop = article || resolvedLayout === 'home';
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f3f5f4" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('theme');
        const dark = saved === 'dark' || (!saved && matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', dark ? '#171817' : '#f3f5f4');
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到主要内容</a>
    <SiteHeader activeSection={activeSection} />
    <div class:list={['site-layout', `site-layout-${resolvedLayout}`]}>
      <div class="content-column">
        <main id="main-content" tabindex="-1">
          <slot />
        </main>
        <footer class="site-footer">
          <span>© {new Date().getFullYear()} {SITE.author} · Astro + Vue</span>
        </footer>
      </div>
    </div>
    {showBackToTop && (
      <BackToTop
        minPageViewports={resolvedLayout === 'home' ? 1.75 : 4}
        showAfterViewports={resolvedLayout === 'home' ? 0.75 : 2.5}
      />
    )}
    <CodeBlockEnhancer />
  </body>
</html>

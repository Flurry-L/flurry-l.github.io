---
import type { MarkdownHeading } from 'astro';
import '../styles/components/post-layout.css';
import '../styles/components/post-meta.css';
import Comments from '../components/Comments.astro';
import PostToc from '../components/PostToc.astro';
import WeekendCalendar from '../features/weekend-calendar/WeekendCalendar.vue';
import type { Post } from '../utils/posts';
import { formatDate, getReadingTime } from '../utils/posts';

interface Props {
  post: Post;
  headings: MarkdownHeading[];
  newer?: Post;
  older?: Post;
  related?: Post[];
}

const { post, headings, newer, older, related = [] } = Astro.props;
---

<div class="reading-progress" data-reading-progress aria-hidden="true"></div>

<div class="article-layout">
  <article class="post-article">
    <header class="post-header">
      <h1>{post.data.title}</h1>
      <div class="post-meta post-header-meta">
        <time class="post-meta-item" datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        <span class="post-meta-item">{getReadingTime(post)} 分钟阅读</span>
        {post.data.updated && (
          <span class="post-meta-item">更新于 {formatDate(post.data.updated)}</span>
        )}
        {post.data.tags.length > 0 && (
          <nav class="post-meta-item meta-tags" aria-label="文章标签">
            {post.data.tags.map((tag) => <a href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a>)}
          </nav>
        )}
        <PostToc headings={headings} variant="compact" />
      </div>
    </header>

    <div class="prose" data-pagefind-body>
      <slot />
    </div>

    {post.data.weekendCalendar && (
      <WeekendCalendar
        client:visible
        instanceId={post.id}
        {...post.data.weekendCalendar}
      />
    )}

    {related.length > 0 && (
      <nav class="post-related" aria-labelledby="post-related-heading">
        <h2 id="post-related-heading">相关文章</h2>
        <ol>
          {related.map((item) => (
            <li>
              <a href={`/${item.id}/`}>
                <span>{item.data.title}</span>
                <small>
                  <time datetime={item.data.date.toISOString()}>{formatDate(item.data.date)}</time>
                  {item.data.tags.length > 0 && ` · ${item.data.tags.map((tag) => `#${tag}`).join(' ')}`}
                </small>
              </a>
            </li>
          ))}
        </ol>
      </nav>
    )}

    <nav class="post-pagination" aria-label="相邻文章" data-floating-controls-clear>
      {older ? (
        <a href={`/${older.id}/`}>
          <small>上一篇</small>
          <span>{older.data.title}</span>
        </a>
      ) : <span />}
      {newer && (
        <a class="next-post" href={`/${newer.id}/`}>
          <small>下一篇</small>
          <span>{newer.data.title}</span>
        </a>
      )}
    </nav>

    <Comments />
  </article>
  <PostToc headings={headings} variant="desktop" />
</div>

<script>
  import { initHeadingAnchors } from '../scripts/heading-anchors';
  import { initPostToc } from '../scripts/post-toc';
  import { initReadingProgress } from '../scripts/reading-progress';

  let cleanupToc: (() => void) | undefined;
  document.addEventListener('astro:page-load', () => {
    cleanupToc = initPostToc();
    initHeadingAnchors();
  });
  document.addEventListener('astro:before-swap', () => {
    cleanupToc?.();
    cleanupToc = undefined;
  });

  initReadingProgress();
</script>

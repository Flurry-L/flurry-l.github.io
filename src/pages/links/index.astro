---
import BaseLayout from '../../layouts/BaseLayout.astro';

const links = [
  {
    name: 'RTXUX',
    url: 'https://blog.rtxux.xyz/',
    description: '看我没有友链后提出交换的 rtx',
    avatar: 'https://avatars.githubusercontent.com/u/6316962',
  },
];
---

<BaseLayout title="友情链接" description="Flurry 的友情链接。">
  <header class="page-intro">
    <h1>朋友们</h1>
  </header>

  <ul class="friend-grid">
    {links.map((link) => (
      <li>
        <a class="friend-card" href={link.url}>
          <img src={link.avatar} width="52" height="52" alt="" />
          <span>
            <strong>{link.name}</strong>
            <small>{link.description}</small>
          </span>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>

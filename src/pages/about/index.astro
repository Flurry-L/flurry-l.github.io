---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const page = await getEntry('pages', 'about');
if (!page) throw new Error('About page not found');
const { Content } = await render(page);
---

<BaseLayout title={page.data.title} description="关于 Flurry：渲染科研者、计算机爱好者和长期玩具玩家。" pageKind="listing">
  <section class="content-card page-card" aria-labelledby="about-heading">
    <header class="page-card-header">
      <h1 id="about-heading">{page.data.title}</h1>
    </header>
    <div class="prose page-card-prose">
      <Content />
    </div>
  </section>
</BaseLayout>

---
import { getCollection } from 'astro:content';
import PostCard from '../components/PostCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getTagCounts, sortPosts } from '../utils/posts';

const posts = sortPosts(await getCollection('posts', ({ data }) => !data.draft));
const tags = getTagCounts(posts);
---

<BaseLayout layout="home">
  <header class="page-intro home-intro">
    <h1>最近更新</h1>
    <div class="home-stats">
      <a href="/archives/" aria-label={`${posts.length} 篇文章`}><strong>{posts.length}</strong> 篇</a>
      <span aria-hidden="true">·</span>
      <a href="/tags/" aria-label={`${tags.length} 个标签`}><strong>{tags.length}</strong> 个标签</a>
    </div>
  </header>

  <section class="post-list" aria-label="文章列表">
    {posts.map((post) => <PostCard post={post} />)}
  </section>
</BaseLayout>

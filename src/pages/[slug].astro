---
import { render } from 'astro:content';
import { getPublishedPosts } from '../data/posts';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostLayout from '../layouts/PostLayout.astro';
import type { Post } from '../utils/posts';
import { getExcerpt } from '../utils/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      newer: index > 0 ? posts[index - 1] : undefined,
      older: index < posts.length - 1 ? posts[index + 1] : undefined,
    },
  }));
}

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
---

<BaseLayout title={post.data.title} description={getExcerpt(post)} pageKind="article">
  <PostLayout post={post} headings={headings} newer={newer} older={older}>
    <Content />
  </PostLayout>
</BaseLayout>

---
import { getPublishedPosts } from '../../data/posts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatMonthDay, formatYear } from '../../utils/posts';

const posts = await getPublishedPosts();
const groups = Object.entries(Object.groupBy(posts, (post) => formatYear(post.data.date)))
  .sort(([a], [b]) => Number(b) - Number(a));
---

<BaseLayout title="归档" description="按年份浏览 Flurry 的全部文章。" pageKind="listing">
  <header class="section-heading section-heading-page">
    <h1>归档</h1>
    <span>{posts.length} 篇</span>
  </header>

  <div class="archive-list">
    {groups.map(([year, yearPosts]) => (
      <section class="archive-year" aria-labelledby={`archive-${year}`}>
        <header class="section-heading">
          <h2 id={`archive-${year}`}>{year}</h2>
          <span>{yearPosts?.length ?? 0} 篇</span>
        </header>
        <ol>
          {yearPosts?.map((post) => (
            <li>
              <a class="content-card archive-card" href={`/${post.id}/`}>
                <span>{post.data.title}</span>
                <time datetime={post.data.date.toISOString()}>{formatMonthDay(post.data.date)}</time>
              </a>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>
</BaseLayout>

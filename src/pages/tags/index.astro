---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTagCounts } from '../../utils/posts';

const posts = await getCollection('posts', ({ data }) => !data.draft);
const tags = getTagCounts(posts);
---

<BaseLayout title="标签" description="按主题浏览 Flurry 的文章。">
  <header class="page-intro">
    <h1>主题索引</h1>
  </header>

  <nav aria-label="全部标签">
    <ul class="tag-cloud">
      {tags.map((tag) => (
        <li>
          <a href={`/tags/${encodeURIComponent(tag.name)}/`}>
            <span>#{tag.name}</span>
            <small>
              <span aria-hidden="true">{tag.count}</span>
              <span class="sr-only">{tag.count} 篇文章</span>
            </small>
          </a>
        </li>
      ))}
    </ul>
  </nav>
</BaseLayout>

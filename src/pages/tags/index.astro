---
import { getPublishedPosts } from '../../data/posts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTagCounts } from '../../utils/posts';

const posts = await getPublishedPosts();
const tags = getTagCounts(posts);
---

<BaseLayout title="标签" description="按主题浏览 Flurry 的文章。" pageKind="listing">
  <header class="section-heading section-heading-page">
    <h1 id="tags-heading">标签</h1>
    <span>{tags.length} 个</span>
  </header>
  <nav aria-labelledby="tags-heading">
    <ul class="tag-cloud">
      {tags.map((tag) => (
        <li>
          <a href={`/tags/${encodeURIComponent(tag.name)}/`}>
            <span>#{tag.name}</span>
            <small>
              <span aria-hidden="true">{tag.count}</span>
              <span class="sr-only">{tag.count} 篇文章</span>
            </small>
          </a>
        </li>
      ))}
    </ul>
  </nav>
</BaseLayout>

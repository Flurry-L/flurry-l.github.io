---
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts } from '../../data/posts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTagCounts, type Post } from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return getTagCounts(posts).map(({ name }) => ({
    params: { tag: name },
    props: { name, posts: posts.filter((post) => post.data.tags.includes(name)) },
  }));
}

interface Props {
  name: string;
  posts: Post[];
}

const { name, posts } = Astro.props;
---

<BaseLayout title={`#${name}`} description={`标签 ${name} 下的文章。`} pageKind="listing">
  <header class="section-heading section-heading-page">
    <h1>#{name}</h1>
    <span>{posts.length} 篇</span>
  </header>
  <section class="post-list tag-post-list" aria-label={`${name} 标签文章`}>
    {posts.map((post) => <PostCard post={post} />)}
  </section>
</BaseLayout>
